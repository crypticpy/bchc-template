{
  "defaults": {
    "standard": "WCAG2AA",
    "runners": ["axe", "htmlcs"],
    "timeout": 60000,
    "wait": 500,
    "chromeLaunchConfig": {
      "args": ["--no-sandbox", "--disable-dev-shm-usage"]
    },
    "concurrency": 1,
    "levelCapWhenNeedsReview": "warning",
    "ignore": []
  },
  "urls": [
    "http://127.0.0.1:4173/",
    "http://127.0.0.1:4173/catalog/",
    "http://127.0.0.1:4173/catalog/?q=triage",
